<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>PbsBrowser.Api</RootNamespace>
    <AssemblyName>PbsBrowser.Api</AssemblyName>
    <!-- The SPA is copied into wwwroot at image build; keep an empty dir tracked in dev. -->
    <SpaRoot>wwwroot\</SpaRoot>
    <!-- Shown in the UI via /api/version. The image build overrides it with the GitVersion version
         (-p:InformationalVersion=$APP_VERSION -p:SourceRevisionId=$GIT_SHA). -->
    <InformationalVersion>0.0.0-local</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PbsBrowser.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
  </ItemGroup>

</Project>
