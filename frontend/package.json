{
  "name": "pbs-browser-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --report-unused-disable-directives --format json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest --coverage",
    "coverage:ci": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "@wshno/eslint-config": "0.2.0",
    "@wshno/prettier-config": "0.1.1",
    "@wshno/tsconfig": "0.1.1",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "6.3.5",
    "vitest": "2.1.8"
  },
  "prettier": "@wshno/prettier-config"
}
